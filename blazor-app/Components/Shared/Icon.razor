@code {
    /// <summary>
    /// The name of the icon to display.
    /// Supported icons: home, plus, star, list, settings, tool, logout, warning, check, clock, flask, 
    /// play, download, file, trash, save, refresh, x, send, printer
    /// </summary>
    [Parameter]
    public string Name { get; set; } = "home";

    /// <summary>
    /// The size of the icon in pixels. Must be between 8 and 128.
    /// </summary>
    [Parameter]
    public int Size { get; set; } = 20;

    protected override void OnParametersSet()
    {
        // Validate Size parameter
        if (Size < 8) Size = 8;
        if (Size > 128) Size = 128;
    }
}
