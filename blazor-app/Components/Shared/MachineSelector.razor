@using BlazorApp.Models
@using BlazorApp.Services
@inject MachineService MachineService
@inject AdsService AdsService
@inject AppStateService AppState

<div class="machine-selector-card">
    <h3>Select Machine</h3>
    
    <div class="machines-grid">
        @foreach (var machine in machines)
        {
            <div class="machine-card @(selectedMachine?.Id == machine.Id ? "selected" : "")" 
                 @onclick="() => SelectMachine(machine)">
                <div class="machine-card-header">
                    <h4>@machine.Name</h4>
                    @if (AppState.IsConnected && AppState.SelectedMachine?.Id == machine.Id)
                    {
                        <span class="badge-connected">● Connected</span>
                    }
                </div>
                <p class="machine-description">@machine.Description</p>
                <div class="machine-details">
                    <div class="detail-item">
                        <span class="detail-label">AMS Net ID:</span>
                        <span class="detail-value">@machine.AmsNetId</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Port:</span>
                        <span class="detail-value">@machine.AmsPort</span>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (error != null)
    {
        <div class="alert alert-danger">
            @error
        </div>
    }

    <div class="button-group">
        @if (!AppState.IsConnected)
        {
            <button class="btn btn-primary" @onclick="Connect" disabled="@(selectedMachine == null || isConnecting)">
                @if (isConnecting)
                {
                    <span>Connecting...</span>
                }
                else
                {
                    <span>Connect to Selected Machine</span>
                }
            </button>
        }
        else
        {
            <button class="btn btn-danger" @onclick="Disconnect">
                Disconnect
            </button>
        }
    </div>
</div>

@code {
    private List<Machine> machines = new();
    private Machine? selectedMachine;
    private bool isConnecting;
    private string? error;

    protected override void OnInitialized()
    {
        machines = MachineService.GetMachines();
        selectedMachine = AppState.SelectedMachine;
        AppState.StateChanged += OnStateChanged;
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void SelectMachine(Machine machine)
    {
        if (!AppState.IsConnected)
        {
            selectedMachine = machine;
            AppState.SetSelectedMachine(machine);
        }
    }

    private async Task Connect()
    {
        if (selectedMachine == null) return;

        isConnecting = true;
        error = null;

        try
        {
            var success = await AdsService.ConnectAsync(selectedMachine.AmsNetId, selectedMachine.AmsPort);
            
            if (!success)
            {
                error = "Failed to connect to PLC. Please check that TwinCAT is running.";
            }
        }
        catch (Exception ex)
        {
            error = $"Connection error: {ex.Message}";
        }
        finally
        {
            isConnecting = false;
        }
    }

    private void Disconnect()
    {
        AdsService.Disconnect();
    }

    public void Dispose()
    {
        AppState.StateChanged -= OnStateChanged;
    }
}

<style>
    .machine-selector-card {
        background-color: white;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .machine-selector-card h3 {
        margin-bottom: 24px;
        color: #212529;
        font-size: 24px;
        font-weight: 600;
    }

    .machines-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 24px;
    }

    .machine-card {
        background-color: #f8f9fa;
        border: 3px solid #dee2e6;
        border-radius: 12px;
        padding: 20px;
        cursor: pointer;
        transition: all 0.2s;
        min-height: 180px;
    }

    .machine-card:hover {
        border-color: #228be6;
        box-shadow: 0 4px 12px rgba(34, 139, 230, 0.15);
        transform: translateY(-2px);
    }

    .machine-card.selected {
        border-color: #228be6;
        background-color: #e7f5ff;
    }

    .machine-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .machine-card h4 {
        margin: 0;
        font-size: 20px;
        font-weight: 600;
        color: #212529;
    }

    .badge-connected {
        background-color: #d3f9d8;
        color: #2b8a3e;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
    }

    .machine-description {
        color: #495057;
        margin-bottom: 16px;
        font-size: 14px;
        line-height: 1.5;
    }

    .machine-details {
        background-color: white;
        border-radius: 6px;
        padding: 12px;
    }

    .detail-item {
        display: flex;
        justify-content: space-between;
        margin: 6px 0;
        font-size: 13px;
    }

    .detail-label {
        font-weight: 600;
        color: #495057;
    }

    .detail-value {
        color: #212529;
        font-family: 'Courier New', monospace;
    }

    .button-group {
        margin-top: 24px;
    }

    .btn {
        padding: 16px 24px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 16px;
        font-weight: 600;
        min-height: 56px;
        width: 100%;
        transition: all 0.2s;
    }

    .btn-primary {
        background-color: #228be6;
        color: white;
    }

    .btn-primary:hover:not(:disabled) {
        background-color: #1c7ed6;
    }

    .btn-danger {
        background-color: #fa5252;
        color: white;
    }

    .btn-danger:hover {
        background-color: #f03e3e;
    }

    .btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .alert {
        padding: 16px;
        border-radius: 8px;
        margin: 16px 0;
        font-size: 15px;
    }

    .alert-danger {
        background-color: #ffe0e0;
        color: #c92a2a;
        border: 2px solid #ffc9c9;
    }
</style>
