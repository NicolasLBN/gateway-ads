@inherits LayoutComponentBase

<div class="page">
    <header class="app-header">
        <div class="header-content">
            <h1 class="app-title">Industrial Application - Gateway ADS</h1>
            <div class="header-right">
                @if (AppState.IsConnected)
                {
                    <span class="connection-badge connected">● Connected</span>
                }
                else
                {
                    <span class="connection-badge disconnected">● Disconnected</span>
                }
            </div>
        </div>
    </header>

    <div class="main-container">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <article class="content">
                @Body
            </article>
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    @inject BlazorApp.Services.AppStateService AppState

    protected override void OnInitialized()
    {
        AppState.StateChanged += OnStateChanged;
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AppState.StateChanged -= OnStateChanged;
    }
}

