@using BlazorApp.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
@implements IDisposable

<nav class="nav-menu">
    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
        <span class="nav-icon"><Icon Name="home" Size="20" /></span>
        <span class="nav-text">Dashboard</span>
    </NavLink>

    <NavLink class="nav-link" href="new-recipe">
        <span class="nav-icon"><Icon Name="plus" Size="20" /></span>
        <span class="nav-text">New Recipe</span>
    </NavLink>

    <NavLink class="nav-link" href="favorites">
        <span class="nav-icon"><Icon Name="star" Size="20" /></span>
        <span class="nav-text">Favorites</span>
    </NavLink>

    <NavLink class="nav-link" href="history">
        <span class="nav-icon"><Icon Name="list" Size="20" /></span>
        <span class="nav-text">History</span>
    </NavLink>

    <NavLink class="nav-link" href="machine-settings">
        <span class="nav-icon"><Icon Name="settings" Size="20" /></span>
        <span class="nav-text">Settings</span>
    </NavLink>

    <NavLink class="nav-link" href="developer">
        <span class="nav-icon"><Icon Name="tool" Size="20" /></span>
        <span class="nav-text">Developer</span>
    </NavLink>

    @if (AuthService.IsAuthenticated)
    {
        <button class="nav-link nav-logout" @onclick="Logout">
            <span class="nav-icon"><Icon Name="logout" Size="20" /></span>
            <span class="nav-text">Logout</span>
        </button>
    }
</nav>

@code {
    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += StateHasChanged;
    }

    private void Logout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= StateHasChanged;
    }
}

<style>
    .nav-menu {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .nav-link {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        color: rgba(255, 255, 255, 0.85);
        text-decoration: none;
        border-radius: 8px;
        font-weight: 500;
        transition: all 0.2s ease;
        white-space: nowrap;
        border: 1px solid transparent;
    }

    .nav-link:hover {
        background-color: rgba(255, 255, 255, 0.15);
        color: white;
        border-color: rgba(255, 255, 255, 0.2);
    }

    .nav-link.active {
        background-color: rgba(255, 255, 255, 0.25);
        color: white;
        border-color: rgba(255, 255, 255, 0.3);
        font-weight: 600;
    }

    .nav-logout {
        background: transparent;
        border: 1px solid transparent;
        cursor: pointer;
    }

    .nav-logout:hover {
        background-color: rgba(255, 100, 100, 0.3);
        border-color: rgba(255, 100, 100, 0.4);
    }

    .nav-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
    }

    .nav-text {
        font-size: 14px;
        letter-spacing: 0.3px;
    }

    @@media (max-width: 768px) {
        .nav-menu {
            gap: 4px;
        }

        .nav-link {
            padding: 10px;
        }

        .nav-text {
            display: none;
        }

        .nav-icon {
            font-size: 22px;
        }
    }
</style>

