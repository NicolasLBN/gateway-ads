@page "/favorites"
@rendermode InteractiveServer
@using BlazorApp.Models
@using BlazorApp.Services
@inject FavoritesService FavoritesService
@inject AdsService AdsService
@inject AppStateService AppState
@inject NavigationManager Navigation

<PageTitle>Favorites</PageTitle>

<div class="favorites-page">
    <div class="page-toolbar">
        <h1 class="page-title">Favorites</h1>
    </div>

    @if (!AppState.IsConnected)
    {
        <div class="alert alert-warn">
            HMI not connected to PLC. You can manage favorites, but sending requires a connection.
        </div>
    }

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">
            @error
            <button class="alert-close" @onclick="() => error = null">×</button>
        </div>
    }

    @if (favorites.Count == 0)
    {
        <div class="empty-state">
            <p>No favorite recipes yet.</p>
            <a href="/new-recipe" class="btn btn-outline">Open recipe</a>
        </div>
    }
    else
    {
        <div class="favorites-grid">
            @foreach (var favorite in favorites)
            {
                <div class="favorite-card">
                    <h3>@favorite.Recipe.Name</h3>
                    <p class="favorite-date">Saved @favorite.SavedAt.ToString("yyyy-MM-dd HH:mm")</p>

                    <div class="favorite-section">
                        <p class="section-label">Steps</p>
                        <div class="badge-list">
                            @foreach (var step in favorite.Recipe.ProcessSteps)
                            {
                                <span class="badge badge-step">@step.TypeLabel</span>
                            }
                            @if (favorite.Recipe.ProcessSteps.Count == 0)
                            {
                                <span class="badge-empty">No steps</span>
                            }
                        </div>
                    </div>

                    <div class="favorite-section">
                        <p class="section-label">Ingredients</p>
                        <div class="badge-list">
                            @foreach (var ingredient in favorite.Recipe.Ingredients.Take(4))
                            {
                                <span class="badge">@ingredient.Name (@ingredient.Amount.ToString("G4") @ingredient.AmountUnit)</span>
                            }
                            @if (favorite.Recipe.Ingredients.Count > 4)
                            {
                                <span class="badge badge-more">+@(favorite.Recipe.Ingredients.Count - 4)</span>
                            }
                        </div>
                    </div>

                    <div class="favorite-actions">
                        <button class="btn btn-primary" @onclick="() => LoadAndSend(favorite)" disabled="@(!AppState.IsConnected || isSending)">
                            @(isSending ? "Sending…" : "Load & send")
                        </button>
                        <button class="btn btn-danger-icon" @onclick="() => DeleteFavorite(favorite.Id)" title="Delete">
                            Delete
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<FavoriteRecipe> favorites = new();
    private bool isSending;
    private string? error;

    protected override void OnInitialized() => LoadFavorites();

    private void LoadFavorites() => favorites = FavoritesService.GetFavorites();

    private async Task LoadAndSend(FavoriteRecipe favorite)
    {
        if (!AppState.IsConnected)
        {
            error = "HMI is not connected to the PLC.";
            return;
        }

        isSending = true;
        error = null;

        try
        {
            var result = await AdsService.SendRecipeAsync(favorite.Recipe);
            if (!result)
            {
                error = "Failed to send recipe to PLC.";
                return;
            }

            AppState.SetCurrentRecipe(favorite.Recipe);
            AppState.ClearProcessHistory();

            var state = AppState.LatestProcessStatus?.State;
            if (state is PackMLState.Stopped or PackMLState.Complete or null)
            {
                await AppState.SendCommandAsync(PackMLCommand.Reset);
                await Task.Delay(250);
            }

            Navigation.NavigateTo("/cooking");
        }
        catch (Exception ex)
        {
            error = $"Error sending recipe: {ex.Message}";
        }
        finally
        {
            isSending = false;
        }
    }

    private void DeleteFavorite(string id)
    {
        FavoritesService.DeleteFavorite(id);
        LoadFavorites();
    }
}
