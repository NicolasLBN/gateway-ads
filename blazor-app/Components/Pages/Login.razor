@page "/login"
@rendermode InteractiveServer
@using BlazorApp.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

<div class="login-page">
    <div class="login-container">
        <div class="login-card">
            <h1 class="login-title">@(isRegisterMode ? "Create Account" : "Login")</h1>
            
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger">
                    @error
                </div>
            }

            @if (!string.IsNullOrEmpty(success))
            {
                <div class="alert alert-success">
                    @success
                </div>
            }

            <div class="form-group">
                <label>Username</label>
                <input type="text" class="form-control" @bind="username" placeholder="Enter username" />
            </div>

            <div class="form-group">
                <label>Password</label>
                <input type="password" class="form-control" @bind="password" placeholder="Enter password" />
            </div>

            @if (isRegisterMode)
            {
                <div class="form-group">
                    <label>Confirm Password</label>
                    <input type="password" class="form-control" @bind="confirmPassword" placeholder="Confirm password" />
                </div>
            }

            <button class="btn btn-primary" @onclick="HandleSubmit">
                @(isRegisterMode ? "Create Account" : "Login")
            </button>

            <div class="toggle-mode">
                @if (isRegisterMode)
                {
                    <p>Already have an account? <a @onclick="ToggleMode">Login here</a></p>
                }
                else
                {
                    <p>Don't have an account? <a @onclick="ToggleMode">Create one</a></p>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string username = "";
    private string password = "";
    private string confirmPassword = "";
    private bool isRegisterMode = false;
    private string? error;
    private string? success;

    protected override void OnInitialized()
    {
        // If already authenticated, redirect to home
        if (AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/");
        }
    }

    private void ToggleMode()
    {
        isRegisterMode = !isRegisterMode;
        error = null;
        success = null;
        password = "";
        confirmPassword = "";
    }

    private void HandleSubmit()
    {
        error = null;
        success = null;

        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            error = "Username and password are required";
            return;
        }

        if (isRegisterMode)
        {
            if (password != confirmPassword)
            {
                error = "Passwords do not match";
                return;
            }

            if (password.Length < 4)
            {
                error = "Password must be at least 4 characters long";
                return;
            }

            var registered = AuthService.Register(username, password);
            if (registered)
            {
                success = "Account created successfully! Please login.";
                isRegisterMode = false;
                password = "";
                confirmPassword = "";
            }
            else
            {
                error = "Username already exists";
            }
        }
        else
        {
            var loggedIn = AuthService.Login(username, password);
            if (loggedIn)
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                error = "Invalid username or password";
            }
        }
    }
}

<style>
    .login-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 20px;
    }

    .login-container {
        width: 100%;
        max-width: 450px;
    }

    .login-card {
        background: white;
        border-radius: 16px;
        padding: 40px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    }

    .login-title {
        text-align: center;
        color: #212529;
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 30px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        font-size: 14px;
        color: #495057;
    }

    .form-control {
        width: 100%;
        padding: 14px;
        border: 2px solid #ddd;
        border-radius: 8px;
        font-size: 16px;
        transition: border-color 0.2s;
        box-sizing: border-box;
    }

    .form-control:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    .btn {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 16px;
        font-weight: 600;
        transition: all 0.2s;
        margin-top: 10px;
    }

    .btn-primary {
        background-color: #667eea;
        color: white;
    }

    .btn-primary:hover {
        background-color: #5568d3;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
    }

    .toggle-mode {
        margin-top: 24px;
        text-align: center;
        font-size: 14px;
        color: #6c757d;
    }

    .toggle-mode a {
        color: #667eea;
        cursor: pointer;
        text-decoration: underline;
        font-weight: 600;
    }

    .toggle-mode a:hover {
        color: #5568d3;
    }

    .alert {
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .alert-danger {
        background-color: #ffe0e0;
        color: #c92a2a;
        border: 2px solid #ffc9c9;
    }

    .alert-success {
        background-color: #d3f9d8;
        color: #2b8a3e;
        border: 2px solid #b2f2bb;
    }
</style>
