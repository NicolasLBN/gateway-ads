@page "/new-recipe"
@rendermode InteractiveServer
@implements IDisposable
@using BlazorApp.Models
@using BlazorApp.Services
@inject AdsService AdsService
@inject AppStateService AppState
@inject FavoritesService FavoritesService
@inject NavigationManager Navigation

<PageTitle>Recipe Details</PageTitle>

<div class="recipe-details-page">
    <div class="page-toolbar">
        <a href="/" class="link-back">Back</a>
        <h1 class="page-title">Recipe Details</h1>
    </div>

    @if (!AppState.IsConnected)
    {
        <div class="alert alert-danger">
            <strong>HMI not connected to PLC</strong>
            <p>Open Machine Settings and connect before sending a recipe.</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">
            @error
            <button class="alert-close" @onclick="() => error = null">×</button>
        </div>
    }

    <div class="form-shell">
        <div class="form-grid">
            <div class="form-col">
                <div class="field large-input-field">
                    <label>Recipe name</label>
                    <div class="input-wrap">
                        <input type="text" maxlength="30" @bind="recipeName" @bind:event="oninput" placeholder="Required" />
                        @if (!string.IsNullOrEmpty(recipeName))
                        {
                            <button type="button" class="clear-btn" @onclick="() => recipeName = string.Empty" title="Clear">×</button>
                        }
                    </div>
                    <span class="counter">@recipeName.Length / 30</span>
                </div>

                <div class="field large-input-field">
                    <label>Preparation volume [L]</label>
                    <div class="input-wrap">
                        <input type="number" step="0.1" @bind="preparationVolume" />
                    </div>
                </div>

                <div class="field large-input-field">
                    <label>Preparation concentration [mol/L]</label>
                    <div class="input-wrap">
                        <input type="number" step="0.01" @bind="preparationConcentration" />
                    </div>
                </div>

                <h2 class="section-title">Ingredients</h2>
                @for (int i = 0; i < ingredients.Count; i++)
                {
                    var index = i;
                    var ing = ingredients[index];
                    <div class="ingredient-block">
                        <div class="ingredient-title-row">
                            <span>Ingredient @(index + 1)</span>
                            @if (ingredients.Count > 1)
                            {
                                <button type="button" class="text-btn danger" @onclick="() => RemoveIngredient(index)">Remove</button>
                            }
                        </div>
                        <div class="field large-input-field">
                            <label>Name</label>
                            <div class="input-wrap">
                                <input type="text" @bind="ing.Name" @bind:event="oninput" />
                            </div>
                        </div>
                        <div class="field-row-3">
                            <div class="field large-input-field">
                                <label>Quantity [g]</label>
                                <div class="input-wrap"><input type="number" @bind="ing.Quantity" /></div>
                            </div>
                            <div class="field large-input-field">
                                <label>Volume [ml]</label>
                                <div class="input-wrap"><input type="number" @bind="ing.Volume" /></div>
                            </div>
                            <div class="field large-input-field">
                                <label>Molar mass [g/L]</label>
                                <div class="input-wrap"><input type="number" @bind="ing.MolarMass" /></div>
                            </div>
                        </div>
                    </div>
                }
                <button type="button" class="btn btn-outline btn-touch" @onclick="AddIngredient">Add ingredient</button>
            </div>

            <div class="form-divider" aria-hidden="true"></div>

            <div class="form-col">
                <h2 class="section-title">Process sequence</h2>
                <p class="helper">Ordered steps sent to the PLC (15 s each in Execute).</p>

                <div class="steps-list">
                    @for (int i = 0; i < steps.Count; i++)
                    {
                        var index = i;
                        <div class="step-item">
                            <span class="step-number">@(index + 1)</span>
                            <span class="step-name">@steps[index]</span>
                            <div class="step-actions">
                                <button type="button" class="icon-btn" disabled="@(index == 0)" @onclick="() => MoveStepUp(index)">▲</button>
                                <button type="button" class="icon-btn" disabled="@(index == steps.Count - 1)" @onclick="() => MoveStepDown(index)">▼</button>
                                <button type="button" class="icon-btn danger" @onclick="() => RemoveStep(index)">×</button>
                            </div>
                        </div>
                    }
                    @if (steps.Count == 0)
                    {
                        <p class="steps-empty">Add at least one process step.</p>
                    }
                </div>

                <div class="add-step-row">
                    <div class="field large-input-field grow">
                        <label>Step type</label>
                        <div class="input-wrap">
                            <select @bind="selectedStepPreset">
                                <option value="Dosage">Dosage</option>
                                <option value="Melange">Melange</option>
                                <option value="Extraction">Extraction</option>
                                <option value="Cuisson">Cuisson</option>
                                <option value="__custom__">Custom…</option>
                            </select>
                        </div>
                    </div>
                    @if (selectedStepPreset == "__custom__")
                    {
                        <div class="field large-input-field grow">
                            <label>Custom name</label>
                            <div class="input-wrap">
                                <input type="text" @bind="customStepName" />
                            </div>
                        </div>
                    }
                </div>
                <button type="button" class="btn btn-outline btn-touch" @onclick="AddStep">Add step</button>
            </div>
        </div>

        <div class="form-actions">
            <button type="button" class="btn btn-outline btn-touch" @onclick="SaveAsFavorite" disabled="@isBusy">
                Save favorite
            </button>
            <button type="button" class="btn btn-primary btn-touch btn-send" @onclick="SendRecipe" disabled="@(!AppState.IsConnected || isBusy)">
                @(isBusy ? "Sending…" : "Send recipe")
            </button>
        </div>
    </div>
</div>

@code {
    private string recipeName = "";
    private double preparationVolume;
    private double preparationConcentration;
    private List<Ingredient> ingredients = new() { new Ingredient() };
    private List<string> steps = new();
    private string selectedStepPreset = "Dosage";
    private string customStepName = "";
    private bool isBusy;
    private string? error;

    protected override void OnInitialized()
    {
        AppState.StateChanged += OnStateChanged;
        if (AppState.CurrentRecipe != null)
        {
            var r = AppState.CurrentRecipe;
            recipeName = r.Name;
            preparationVolume = r.PreparationVolume;
            preparationConcentration = r.PreparationConcentration;
            ingredients = r.Ingredients.Count > 0 ? r.Ingredients.Select(CopyIngredient).ToList() : new() { new Ingredient() };
            steps = r.Steps.ToList();
        }
    }

    private static Ingredient CopyIngredient(Ingredient i) => new()
    {
        Name = i.Name,
        Quantity = i.Quantity,
        Volume = i.Volume,
        MolarMass = i.MolarMass
    };

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void AddIngredient() => ingredients.Add(new Ingredient());
    private void RemoveIngredient(int index) => ingredients.RemoveAt(index);

    private void AddStep()
    {
        var name = selectedStepPreset == "__custom__" ? customStepName.Trim() : selectedStepPreset;
        if (string.IsNullOrWhiteSpace(name)) return;
        steps.Add(name);
        customStepName = "";
    }

    private void RemoveStep(int index) => steps.RemoveAt(index);

    private void MoveStepUp(int index)
    {
        if (index <= 0) return;
        (steps[index - 1], steps[index]) = (steps[index], steps[index - 1]);
    }

    private void MoveStepDown(int index)
    {
        if (index >= steps.Count - 1) return;
        (steps[index + 1], steps[index]) = (steps[index], steps[index + 1]);
    }

    private Recipe BuildRecipe() => new()
    {
        Name = recipeName,
        Ingredients = ingredients.ToList(),
        PreparationVolume = preparationVolume,
        PreparationConcentration = preparationConcentration,
        Steps = steps.ToList()
    };

    private async Task SendRecipe()
    {
        if (!AppState.IsConnected)
        {
            error = "HMI is not connected to the PLC.";
            return;
        }

        if (string.IsNullOrWhiteSpace(recipeName))
        {
            error = "Recipe name is required.";
            return;
        }

        if (ingredients.Count == 0 || string.IsNullOrWhiteSpace(ingredients[0].Name))
        {
            error = "Add at least one ingredient.";
            return;
        }

        if (steps.Count == 0)
        {
            error = "Add at least one process step.";
            return;
        }

        isBusy = true;
        error = null;

        try
        {
            var recipe = BuildRecipe();
            var result = await AdsService.SendRecipeAsync(recipe);
            if (!result)
            {
                error = "Failed to send recipe to PLC.";
                return;
            }

            AppState.SetCurrentRecipe(recipe);
            AppState.ClearProcessHistory();

            var state = AppState.LatestProcessStatus?.State;
            if (state is PackMLState.Stopped or PackMLState.Complete or null)
            {
                await AppState.SendCommandAsync(PackMLCommand.Reset);
                await Task.Delay(250);
            }

            Navigation.NavigateTo("/cooking");
        }
        catch (Exception ex)
        {
            error = $"Error sending recipe: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private void SaveAsFavorite()
    {
        if (string.IsNullOrWhiteSpace(recipeName))
        {
            error = "Enter a recipe name before saving.";
            return;
        }

        FavoritesService.AddFavorite(BuildRecipe());
    }

    public void Dispose() => AppState.StateChanged -= OnStateChanged;
}
