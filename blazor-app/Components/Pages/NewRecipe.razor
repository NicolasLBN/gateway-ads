@page "/new-recipe"
@rendermode InteractiveServer
@using BlazorApp.Components.Shared
@using BlazorApp.Models
@using BlazorApp.Services
@using Microsoft.AspNetCore.WebUtilities
@inject AdsService AdsService
@inject AppStateService AppState
@inject ReportService ReportService
@inject HtmlReportService HtmlReportService
@inject FavoritesService FavoritesService
@inject NavigationManager Navigation

<PageTitle>New Recipe</PageTitle>

<div class="new-recipe-page">
    <div class="page-header">
        <h1 class="page-title">New Recipe</h1>
        <a href="/" class="btn-back">← Back to Home</a>
    </div>

    @if (!AppState.IsConnected)
    {
        <div class="alert alert-danger">
            <strong><Icon Name="warning" Size="16" /> Not Connected</strong>
            <p>Not connected to machine. Please go to Machine Settings to connect.</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">
            @error
            <button class="alert-close" @onclick="() => error = null"><Icon Name="x" Size="14" /></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(success))
    {
        <div class="alert alert-success">
            @success
            <button class="alert-close" @onclick="() => success = null"><Icon Name="x" Size="14" /></button>
        </div>
    }

    <div class="recipe-grid">
        <div class="recipe-form-section">
            <div class="card">
                <h2>Recipe Details</h2>
                
                <div class="form-group">
                    <label>Recipe Name</label>
                    <input type="text" class="form-control" @bind="recipeName" placeholder="Enter recipe name" />
                </div>

                <h3>Chemical Components</h3>
                
                @foreach (var (ingredient, index) in ingredients.Select((ing, idx) => (ing, idx)))
                {
                    <div class="ingredient-card">
                        <div class="ingredient-header">
                            <span>Component @(index + 1)</span>
                            @if (ingredients.Count > 1)
                            {
                                <button class="btn-icon-danger" @onclick="() => RemoveIngredient(index)"><Icon Name="trash" Size="16" /></button>
                            }
                        </div>

                        <div class="form-group">
                            <label>Chemical Name</label>
                            <input type="text" class="form-control" @bind="ingredient.Name" placeholder="@GetChemicalPlaceholder(index)" />
                        </div>
                        
                        <div class="ingredient-fields">
                            <div class="form-group">
                                <label>Volume (mL)</label>
                                <input type="number" class="form-control-sm" @bind="ingredient.Volume" placeholder="0.00" step="0.1" />
                            </div>
                            <div class="form-group">
                                <label>Molar Mass (g/mol)</label>
                                <input type="number" class="form-control-sm" @bind="ingredient.MolarMass" placeholder="0.00" step="0.01" />
                            </div>
                        </div>
                    </div>
                }

                <button class="btn btn-secondary" @onclick="AddIngredient">
                    <Icon Name="plus" Size="16" /> Add Component
                </button>

                <div class="action-buttons">
                    <button class="btn btn-primary" @onclick="SendRecipe" disabled="@(!AppState.IsConnected || isSubmitting)">
                        @if (isSubmitting)
                        {
                            <span>Sending...</span>
                        }
                        else
                        {
                            <span>Send Recipe to PLC</span>
                        }
                    </button>
                    <button class="btn btn-success" @onclick="RunProcess" disabled="@(!AppState.IsConnected || isRunning)">
                        @if (isRunning)
                        {
                            <span>Starting...</span>
                        }
                        else
                        {
                            <span><Icon Name="play" Size="16" /> Run Process</span>
                        }
                    </button>
                </div>

                @if (AppState.LatestProcessStatus?.ProcessDone == true && !showSaveDialog)
                {
                    <div class="process-complete-notice">
                        <p><Icon Name="check" Size="20" /> Process completed successfully!</p>
                        <button class="btn btn-success" @onclick="ShowSaveDialog">
                            <Icon Name="save" Size="16" /> Save Recording
                        </button>
                        <button class="btn btn-secondary" @onclick="DiscardRecording">
                            <Icon Name="x" Size="16" /> Discard
                        </button>
                    </div>
                }
            </div>
        </div>

        <div class="monitoring-section">
            <MachineStatus />
            <ProcessTimeline />
        </div>
    </div>

    <div class="chart-section">
        <RealtimeChart />
    </div>

    @if (showSaveDialog)
    {
        <div class="modal-overlay" @onclick="() => showSaveDialog = false">
            <div class="modal-content" @onclick:stopPropagation="true">
                <h2>Save Process Recording</h2>
                <p>Would you like to save this process recording to the reports?</p>
                <div class="modal-info">
                    <p><strong>Recipe:</strong> @recipeName</p>
                    <p><strong>Machine:</strong> @(AppState.SelectedMachine?.Name ?? "Unknown")</p>
                    <p><strong>Duration:</strong> @(AppState.LatestProcessStatus?.TotalTime ?? 0) seconds</p>
                </div>
                <div class="modal-actions">
                    <button class="btn btn-success" @onclick="SaveAndGenerateReport">
                        <Icon Name="save" Size="16" /> Save & Generate Report
                    </button>
                    <button class="btn btn-secondary" @onclick="() => showSaveDialog = false">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private const int RECIPE_PROCESSING_DELAY_MS = 200;
    private const int NAVIGATION_DELAY_MS = 2000;
    
    private string recipeName = "";
    private List<Ingredient> ingredients = new() { new Ingredient() };
    private bool isSubmitting = false;
    private bool isRunning = false;
    private bool showSaveDialog = false;
    private string? error;
    private string? success;

    protected override void OnInitialized()
    {
        AppState.StateChanged += OnStateChanged;
        
        // Load from favorite if favoriteId is provided in query string
        var uri = new Uri(Navigation.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("favoriteId", out var favoriteIdStr))
        {
            if (int.TryParse(favoriteIdStr, out var favoriteId))
            {
                LoadFromFavorite(favoriteId);
            }
        }
    }

    private void LoadFromFavorite(int favoriteId)
    {
        var favorite = FavoritesService.GetFavorite(favoriteId);
        if (favorite != null)
        {
            recipeName = favorite.Name;
            ingredients = favorite.Ingredients.Select(i => new Ingredient
            {
                Name = i.Name,
                Volume = i.Volume,
                MolarMass = i.MolarMass
            }).ToList();
            
            if (ingredients.Count == 0)
            {
                ingredients = new() { new Ingredient() };
            }
            
            success = $"Recipe loaded from favorite: {favorite.Name}";
        }
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void AddIngredient()
    {
        ingredients.Add(new Ingredient());
    }

    private void RemoveIngredient(int index)
    {
        ingredients.RemoveAt(index);
    }

    private string GetChemicalPlaceholder(int index)
    {
        var chemicals = new[]
        {
            "Sodium Hydroxide (NaOH)",
            "Hydrochloric Acid (HCl)",
            "Sulfuric Acid (H₂SO₄)",
            "Ethanol (C₂H₅OH)",
            "Acetone (C₃H₆O)",
            "Sodium Chloride (NaCl)",
            "Potassium Permanganate (KMnO₄)",
            "Calcium Carbonate (CaCO₃)",
            "Acetic Acid (CH₃COOH)",
            "Benzene (C₆H₆)"
        };
        return chemicals[index % chemicals.Length];
    }

    private async Task SendRecipe()
    {
        if (!AppState.IsConnected)
        {
            error = "Please connect to a machine first";
            return;
        }

        if (string.IsNullOrWhiteSpace(recipeName))
        {
            error = "Please enter a recipe name";
            return;
        }

        if (ingredients.Count == 0 || string.IsNullOrWhiteSpace(ingredients[0].Name))
        {
            error = "Please add at least one ingredient";
            return;
        }

        isSubmitting = true;
        error = null;
        success = null;

        try
        {
            var recipe = new Recipe
            {
                Name = recipeName,
                Ingredients = ingredients.ToList(),
                PreparationVolume = 0,
                PreparationConcentration = 0
            };

            var result = await AdsService.SendRecipeAsync(recipe);

            if (result)
            {
                AppState.SetCurrentRecipe(recipe);
                success = "Recipe sent successfully to PLC!";
            }
            else
            {
                error = "Failed to send recipe";
            }
        }
        catch (Exception ex)
        {
            error = $"Error sending recipe: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task RunProcess()
    {
        if (!AppState.IsConnected)
        {
            error = "Please connect to a machine first";
            return;
        }

        if (string.IsNullOrWhiteSpace(recipeName))
        {
            error = "Please enter a recipe name before running the process";
            return;
        }

        if (ingredients.Count == 0 || string.IsNullOrWhiteSpace(ingredients[0].Name))
        {
            error = "Please add at least one ingredient before running the process";
            return;
        }

        isRunning = true;
        error = null;
        success = null;
        AppState.ClearProcessHistory();

        try
        {
            // First, ensure recipe is sent to PLC
            var recipe = new Recipe
            {
                Name = recipeName,
                Ingredients = ingredients.ToList(),
                PreparationVolume = 0,
                PreparationConcentration = 0
            };

            var recipeSent = await AdsService.SendRecipeAsync(recipe);
            if (!recipeSent)
            {
                error = "Failed to send recipe to PLC. Please check the connection and try again.";
                return;
            }

            AppState.SetCurrentRecipe(recipe);
            
            // Small delay to ensure PLC has processed the recipe
            await Task.Delay(RECIPE_PROCESSING_DELAY_MS);

            // Now start the process
            var result = await AdsService.StartProcessAsync();
            if (result)
            {
                success = "Process started successfully with recipe!";
            }
            else
            {
                error = "Failed to start process";
            }
        }
        catch (Exception ex)
        {
            error = $"Error starting process: {ex.Message}";
        }
        finally
        {
            isRunning = false;
        }
    }

    private void ShowSaveDialog()
    {
        showSaveDialog = true;
    }

    private async Task DiscardRecording()
    {
        try
        {
            await AdsService.ResetProcessAsync();
            AppState.ClearProcessHistory();
            success = "Recording discarded";
            showSaveDialog = false;
        }
        catch (Exception ex)
        {
            error = $"Error discarding recording: {ex.Message}";
        }
    }

    private async Task SaveAndGenerateReport()
    {
        try
        {
            showSaveDialog = false;
            
            // Get actual process steps from recorded history
            var processSteps = AppState.GetProcessStepsFromHistory();
            
            // Fallback to empty list if no data captured
            if (processSteps.Count == 0)
            {
                error = "No process data captured. Please ensure the process completed successfully.";
                return;
            }

            var report = new Report
            {
                RecipeName = recipeName,
                MachineName = AppState.SelectedMachine?.Name ?? "Unknown",
                Date = DateTime.Now,
                Products = ingredients.ToList(),
                Steps = processSteps
            };

            ReportService.AddReport(report);
            var fileName = HtmlReportService.GenerateReport(report);
            
            success = "Report saved successfully!";
            
            await Task.Delay(NAVIGATION_DELAY_MS);
            Navigation.NavigateTo("/history");
        }
        catch (Exception ex)
        {
            error = $"Error saving report: {ex.Message}";
        }
    }

    private async Task GenerateReport()
    {
        try
        {
            // Get actual process steps from recorded history
            var processSteps = AppState.GetProcessStepsFromHistory();
            
            // Fallback to empty list if no data captured
            if (processSteps.Count == 0)
            {
                error = "No process data captured. Please ensure the process completed successfully.";
                return;
            }

            var report = new Report
            {
                RecipeName = recipeName,
                MachineName = AppState.SelectedMachine?.Name ?? "Unknown",
                Date = DateTime.Now,
                Products = ingredients.ToList(),
                Steps = processSteps
            };

            ReportService.AddReport(report);
            var fileName = HtmlReportService.GenerateReport(report);
            
            success = "Report generated successfully!";
            
            await Task.Delay(NAVIGATION_DELAY_MS);
            Navigation.NavigateTo("/history");
        }
        catch (Exception ex)
        {
            error = $"Error generating report: {ex.Message}";
        }
    }

    public void Dispose()
    {
        AppState.StateChanged -= OnStateChanged;
    }
}

