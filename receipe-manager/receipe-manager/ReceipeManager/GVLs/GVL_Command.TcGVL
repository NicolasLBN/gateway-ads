<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_Command" Id="{1facbee3-cc79-4c77-b9b0-10de473c41bd}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    // PackML commands - written by the Blazor client as momentary pulses (TRUE then FALSE)
    bReset      : BOOL;
    bClear      : BOOL;
    bStart      : BOOL;
    bHold       : BOOL;
    bStop       : BOOL;

    // Set by the Blazor client right after a successful ADS connection
    bAdsConnected : BOOL;
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>