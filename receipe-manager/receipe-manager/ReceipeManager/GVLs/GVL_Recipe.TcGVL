<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_Recipe" Id="{91e53493-40a9-4f8d-9191-2924edbc6542}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
    MAX_STEPS       : UINT := 20;
    MAX_INGREDIENTS : UINT := 10;
END_VAR

VAR_GLOBAL
    // Recipe metadata - written by the Blazor client before Start
    sRecipeName             : STRING(254);
    fPreparationVolume      : REAL;
    fPreparationConcentration : REAL;

    // Ordered process step sequence (e.g. Dosage, Melange, Extraction, Cuisson)
    nNumSteps               : UINT;
    aStepNames              : ARRAY[1..20] OF STRING(254);

    // Ingredients and their quantities
    nNumIngredients         : UINT;
    aIngredientName         : ARRAY[1..10] OF STRING(254);
    aIngredientQuantity     : ARRAY[1..10] OF REAL;
    aIngredientVolume       : ARRAY[1..10] OF REAL;
    aIngredientMolarMass    : ARRAY[1..10] OF REAL;
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>