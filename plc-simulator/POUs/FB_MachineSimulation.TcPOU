<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.0">
  <POU Name="FB_MachineSimulation" Id="{12345678-1234-1234-1234-123456789012}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MachineSimulation
VAR
    RandomSeed : DINT := 12345;
    Counter : UDINT := 0;
    TargetTemp : REAL := 25.0;
    TargetPressure : REAL := 1.0;
    TargetSpeed : REAL := 0.0;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[Counter := Counter + 1;

// Simple random simulation
RandomSeed := (RandomSeed * 1103515245 + 12345) MOD 2147483647;

// Set target values based on current process step (pharmaceutical process simulation)
CASE GVL_Process.CurrentStep OF
    0: // Idle
        TargetTemp := 25.0;
        TargetPressure := 1.0;
        TargetSpeed := 0.0;
        
    1: // Preparation
        TargetTemp := 25.0;
        TargetPressure := 1.0;
        TargetSpeed := 0.0;
        
    2: // Dosing Ingredient A
        TargetTemp := 30.0;
        TargetPressure := 1.0;
        TargetSpeed := 150.0;
        
    3: // Dosing Ingredient B
        TargetTemp := 45.0;
        TargetPressure := 1.2;
        TargetSpeed := 200.0;
        
    4: // Mixing
        TargetTemp := 85.0;
        TargetPressure := 1.5;
        TargetSpeed := 350.0;
        
    5: // Verification/Cooling
        TargetTemp := 40.0;
        TargetPressure := 1.2;
        TargetSpeed := 200.0;
        
    6: // Finalizing
        TargetTemp := 25.0;
        TargetPressure := 1.0;
        TargetSpeed := 0.0;
        
    7: // Done
        TargetTemp := 25.0;
        TargetPressure := 1.0;
        TargetSpeed := 0.0;
END_CASE

// Simulate machine behavior with gradual transitions to target values
IF GVL_Process.CurrentStep > 0 AND GVL_Process.CurrentStep < 7 THEN
    // Gradually adjust temperature towards target
    IF ABS(GVL_Machine.MotorTemperature - TargetTemp) > 0.5 THEN
        IF GVL_Machine.MotorTemperature < TargetTemp THEN
            GVL_Machine.MotorTemperature := GVL_Machine.MotorTemperature + 0.2;
        ELSE
            GVL_Machine.MotorTemperature := GVL_Machine.MotorTemperature - 0.2;
        END_IF
    ELSE
        GVL_Machine.MotorTemperature := TargetTemp;
    END_IF
    
    // Add small random fluctuations to temperature
    GVL_Machine.MotorTemperature := GVL_Machine.MotorTemperature + (DINT_TO_REAL(RandomSeed MOD 20) - 10.0) / 20.0;
    
    // Gradually adjust speed towards target
    IF ABS(GVL_Machine.MotorSpeed - TargetSpeed) > 5.0 THEN
        IF GVL_Machine.MotorSpeed < TargetSpeed THEN
            GVL_Machine.MotorSpeed := GVL_Machine.MotorSpeed + 5.0;
        ELSE
            GVL_Machine.MotorSpeed := GVL_Machine.MotorSpeed - 5.0;
        END_IF
    ELSE
        GVL_Machine.MotorSpeed := TargetSpeed;
    END_IF
    
    // Add small random fluctuations to speed
    IF TargetSpeed > 0.0 THEN
        GVL_Machine.MotorSpeed := GVL_Machine.MotorSpeed + (DINT_TO_REAL(RandomSeed MOD 10) - 5.0);
    END_IF
    
    // Gradually adjust pressure towards target
    IF ABS(GVL_Machine.OilPressure - TargetPressure) > 0.05 THEN
        IF GVL_Machine.OilPressure < TargetPressure THEN
            GVL_Machine.OilPressure := GVL_Machine.OilPressure + 0.02;
        ELSE
            GVL_Machine.OilPressure := GVL_Machine.OilPressure - 0.02;
        END_IF
    ELSE
        GVL_Machine.OilPressure := TargetPressure;
    END_IF
    
    // Add small random fluctuations to pressure
    GVL_Machine.OilPressure := GVL_Machine.OilPressure + (DINT_TO_REAL(RandomSeed MOD 10) - 5.0) / 100.0;
    
ELSIF GVL_Process.CurrentStep = 0 THEN
    // Idle state
    GVL_Machine.MotorSpeed := 0.0;
    
    // Temperature cools down to ambient
    IF GVL_Machine.MotorTemperature > 25.0 THEN
        GVL_Machine.MotorTemperature := GVL_Machine.MotorTemperature - 0.1;
    ELSIF GVL_Machine.MotorTemperature < 25.0 THEN
        GVL_Machine.MotorTemperature := GVL_Machine.MotorTemperature + 0.1;
    END_IF
    
    // Pressure returns to atmospheric
    IF GVL_Machine.OilPressure > 1.0 THEN
        GVL_Machine.OilPressure := GVL_Machine.OilPressure - 0.02;
    ELSIF GVL_Machine.OilPressure < 1.0 THEN
        GVL_Machine.OilPressure := GVL_Machine.OilPressure + 0.02;
    END_IF
    
ELSE
    // Done state
    GVL_Machine.MotorSpeed := 0.0;
    
    // Maintain final temperature
    IF GVL_Machine.MotorTemperature > 25.0 THEN
        GVL_Machine.MotorTemperature := GVL_Machine.MotorTemperature - 0.05;
    END_IF
    
    GVL_Machine.OilPressure := 1.0;
END_IF

// Warning flags based on pharmaceutical process limits
GVL_Machine.TempWarning := (GVL_Machine.MotorTemperature > 95.0) OR (GVL_Machine.MotorTemperature < 15.0);
GVL_Machine.PressureWarning := (GVL_Machine.OilPressure < 0.5) OR (GVL_Machine.OilPressure > 2.0);
GVL_Machine.SpeedWarning := (GVL_Machine.MotorSpeed > 400.0);

// Simulate random anomaly (0.5% chance per cycle, reduced from 1%)
IF (RandomSeed MOD 200) = 0 AND GVL_Process.CurrentStep > 0 AND GVL_Process.CurrentStep < 7 THEN
    GVL_Process.ErrorCode := 1;
    GVL_Process.ErrorText := 'Sensor anomaly detected';
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
