<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{e0fecc08-7b74-4584-a39d-b6654d92e1d4}">
    <Declaration><![CDATA[PROGRAM MAIN
VAR CONSTANT
    // PackML state codes - mirrored 1:1 by BlazorApp.Models.PackMLState
    ST_CLEARING     : INT := 0;
    ST_STOPPED      : INT := 1;
    ST_RESETTING    : INT := 2;
    ST_IDLE         : INT := 3;
    ST_STARTING     : INT := 4;
    ST_EXECUTE      : INT := 5;
    ST_COMPLETING   : INT := 6;
    ST_COMPLETE     : INT := 7;
END_VAR
VAR
    trigReset   : R_TRIG;
    trigClear   : R_TRIG;
    trigStart   : R_TRIG;
    trigStop    : R_TRIG;

    tonStep     : TON;
    bStepActive : BOOL;
    nElapsedMs  : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Edge detection on momentary PackML commands from the Blazor client
// ============================================================
trigReset(CLK := GVL_Command.bReset);
trigClear(CLK := GVL_Command.bClear);
trigStart(CLK := GVL_Command.bStart);
trigStop(CLK := GVL_Command.bStop);

// Hold is a level signal: while TRUE the active step countdown is frozen.
// Held/Holding are not part of this PackML subset, so nState is left unchanged.
GVL_State.bHeld := GVL_Command.bHold;

// ============================================================
// PackML state machine
// ============================================================
CASE GVL_State.nState OF

ST_CLEARING:
    // Power-up / fault-clear state: wipe any previous run data, then move on
    GVL_Process.nCurrentStepIndex    := 0;
    GVL_Process.sCurrentStepName     := '';
    GVL_Process.nStepTimeElapsed_s   := 0;
    GVL_Process.nStepTimeRemaining_s := 0;
    GVL_Process.nTotalSteps          := 0;
    GVL_Process.fProgress            := 0.0;
    GVL_Process.bProcessDone         := FALSE;
    GVL_Process.nErrorCode           := 0;
    GVL_Process.sErrorText           := '';
    bStepActive := FALSE;
    tonStep(IN := FALSE, PT := T#15S);

    GVL_State.nState := ST_STOPPED;

ST_STOPPED:
    IF trigReset.Q THEN
        GVL_State.nState := ST_RESETTING;
    ELSIF trigClear.Q THEN
        GVL_State.nState := ST_CLEARING;
    END_IF

ST_RESETTING:
    GVL_Process.nCurrentStepIndex    := 0;
    GVL_Process.sCurrentStepName     := '';
    GVL_Process.nStepTimeElapsed_s   := 0;
    GVL_Process.nStepTimeRemaining_s := 0;
    GVL_Process.fProgress            := 0.0;
    GVL_Process.bProcessDone         := FALSE;
    GVL_Process.nErrorCode           := 0;
    GVL_Process.sErrorText           := '';
    bStepActive := FALSE;
    tonStep(IN := FALSE, PT := T#15S);

    GVL_State.nState := ST_IDLE;

ST_IDLE:
    IF trigStart.Q THEN
        IF GVL_Recipe.nNumSteps > 0 THEN
            GVL_Process.nErrorCode := 0;
            GVL_Process.sErrorText := '';
            GVL_State.nState := ST_STARTING;
        ELSE
            GVL_Process.nErrorCode := 1;
            GVL_Process.sErrorText := 'No recipe loaded: send a recipe with at least one step before Start';
        END_IF
    ELSIF trigStop.Q THEN
        GVL_State.nState := ST_STOPPED;
    END_IF

ST_STARTING:
    // Snapshot the loaded recipe and prepare the first step
    GVL_Process.nTotalSteps          := GVL_Recipe.nNumSteps;
    GVL_Process.nCurrentStepIndex    := 1;
    GVL_Process.sCurrentStepName     := GVL_Recipe.aStepNames[1];
    GVL_Process.nStepTimeElapsed_s   := 0;
    GVL_Process.nStepTimeRemaining_s := 15;
    GVL_Process.fProgress            := 0.0;
    GVL_Process.bProcessDone         := FALSE;
    bStepActive := TRUE;
    tonStep(IN := FALSE, PT := T#15S);

    GVL_State.nState := ST_EXECUTE;

ST_EXECUTE:
    IF trigStop.Q THEN
        bStepActive := FALSE;
        tonStep(IN := FALSE, PT := T#15S);
        GVL_State.nState := ST_STOPPED;
    ELSE
        // Strict 15s countdown for the active step, paused while Held
        tonStep(IN := bStepActive AND NOT GVL_State.bHeld, PT := T#15S);

        IF NOT GVL_State.bHeld THEN
            nElapsedMs := TIME_TO_UDINT(tonStep.ET);
            GVL_Process.nStepTimeElapsed_s := UDINT_TO_UINT(nElapsedMs / 1000);
            IF GVL_Process.nStepTimeElapsed_s > 15 THEN
                GVL_Process.nStepTimeElapsed_s := 15;
            END_IF
            GVL_Process.nStepTimeRemaining_s := 15 - GVL_Process.nStepTimeElapsed_s;
        END_IF

        GVL_Process.fProgress := (UINT_TO_REAL(GVL_Process.nCurrentStepIndex - 1) +
            (UINT_TO_REAL(GVL_Process.nStepTimeElapsed_s) / 15.0)) / UINT_TO_REAL(GVL_Process.nTotalSteps);

        IF tonStep.Q THEN
            // Step finished: advance to the next one or finish the recipe
            tonStep(IN := FALSE, PT := T#15S);

            IF GVL_Process.nCurrentStepIndex < GVL_Process.nTotalSteps THEN
                GVL_Process.nCurrentStepIndex    := GVL_Process.nCurrentStepIndex + 1;
                GVL_Process.sCurrentStepName     := GVL_Recipe.aStepNames[GVL_Process.nCurrentStepIndex];
                GVL_Process.nStepTimeElapsed_s   := 0;
                GVL_Process.nStepTimeRemaining_s := 15;
            ELSE
                bStepActive := FALSE;
                GVL_State.nState := ST_COMPLETING;
            END_IF
        END_IF
    END_IF

ST_COMPLETING:
    GVL_Process.fProgress            := 1.0;
    GVL_Process.nStepTimeRemaining_s := 0;
    GVL_State.nState := ST_COMPLETE;

ST_COMPLETE:
    GVL_Process.bProcessDone := TRUE;

    IF trigReset.Q THEN
        GVL_State.nState := ST_RESETTING;
    ELSIF trigClear.Q THEN
        GVL_State.nState := ST_CLEARING;
    END_IF

ELSE
    GVL_State.nState := ST_CLEARING;

END_CASE

// ============================================================
// Human readable state name, mirrors nState 1:1
// ============================================================
CASE GVL_State.nState OF
    ST_CLEARING:    GVL_State.sStateName := 'Clearing';
    ST_STOPPED:     GVL_State.sStateName := 'Stopped';
    ST_RESETTING:   GVL_State.sStateName := 'Resetting';
    ST_IDLE:        GVL_State.sStateName := 'Idle';
    ST_STARTING:    GVL_State.sStateName := 'Starting';
    ST_EXECUTE:     GVL_State.sStateName := 'Execute';
    ST_COMPLETING:  GVL_State.sStateName := 'Completing';
    ST_COMPLETE:    GVL_State.sStateName := 'Complete';
ELSE
    GVL_State.sStateName := 'Unknown';
END_CASE
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>