<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_State" Id="{d3aba268-1bac-42bc-814d-544617ebc1f5}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    // Current PackML state, exposed both as a numeric code and as text so the
    // Blazor client does not need to share an ADS-mapped enum type.
    // 0=Clearing 1=Stopped 2=Resetting 3=Idle 4=Starting 5=Execute 6=Completing 7=Complete
    nState      : INT := 0;
    sStateName  : STRING(254) := 'Clearing';

    // TRUE while a Hold command is active - freezes the step countdown without
    // changing nState (Held/Holding are not part of this PackML subset).
    bHeld       : BOOL;
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>